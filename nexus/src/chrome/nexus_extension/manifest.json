{
  "manifest_version": 3,
  "name": "Nexus PLM + AI Integration",
  "version": "1.0.0",
  "description": "Engineering browser integration: local AI (Gemini Nano + WebLLM), PLM side panel, plm:// protocol.",
  "permissions": [
    "sidePanel",
    "storage",
    "notifications",
    "background",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Nexus",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "_nexus": {
    "component_extension": true,
    "user_removable": false,
    "auto_grant_permissions": true
  }
}
